  m_Script: {fileID: 11500000, guid: 071920c32a6056558a742a9ffe847d34, type: 3}
  m_Name: NPC_HospitalWorker
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  npcId: hospital_worker
  entries:
  - requiredProgress: 0
    playerLine: Hola, necesito sacar un turno.
    npcLine: "Pregunte en recepci\xF3n."
  - requiredProgress: 1
    playerLine: "Hola \xBFD\xF3nde queda este lugar?"
    npcLine: Lea el cartel
  - requiredProgress: 1
    playerLine: "No s\xE9 leer."
    npcLine: Bue..
  - requiredProgress: 3
    playerLine: "Me dijeron que tengo que hacer unos estudios \xBFSabe a d\xF3nde
      tengo que ir?"
    npcLine: "Estoy ocupado se\xF1ora, lea los carteles."
  - requiredProgress: 4
    playerLine: "\xBFPodr\xEDa decirme d\xF3nde queda esto?"
    npcLine: Estoy ocupado, no moleste.
  - requiredProgress: 5
    playerLine: "Me dijeron que retire los estudios en la recepci\xF3n."
    npcLine: "\xBFUsted me vio cara de recepci\xF3n?"
  - requiredProgress: 6
    playerLine: "Ya saqu\xE9 la orden de retiro de estudios \xBFSabe a d\xF3nde tengo
      que ir?"
    npcLine: No me moleste, estoy trabajando.
  - requiredProgress: 7
    playerLine: "Necesito ayuda para saber c\xF3mo continuar con esto."
    npcLine: Busque a alguien que la ayude.
  - requiredProgress: 8
    playerLine: "Disculpe \xBFPuede ayudarme ocn esto?"
    npcLine: No. Estoy ocupado.
