  npcId: Secretary
  entries:
  - requiredProgress: 0
    playerLine: "Hola, me dijeron que pase por secretar\xEDa, soy Carmela, la mam\xE1
      de Bruno"
    npcLine: "S\xED, necesitamos que termine de completar la documentaci\xF3n de
      Bruno"
  - requiredProgress: 0
    playerLine: "\xBFQue documentaci\xF3n falta?"
    npcLine: "Falta su apto m\xE9dico, tiene que traerlo antes del viernes o su inscripci\xF3n
      no se har\xE1 efectiva"
  - requiredProgress: 9
    playerLine: "Aqu\xED tiene toda la documentaci\xF3n completa de Bruno."
    npcLine: "Qu\xE9 bueno que trajo los documentos, Bruno podr\xE1 seguir en la
      escuela."
