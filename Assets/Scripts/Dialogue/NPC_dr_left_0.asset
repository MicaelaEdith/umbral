  entries:
  - requiredProgress: 1
    playerLine: "Hola, necesito hacer el apto f\xEDsico para mi hijo."
    npcLine: "Tiene que ir a pediatr\xEDa, en la otra sala del hospital."
  - requiredProgress: 3
    playerLine: "Hola, necesito hacer este tr\xE1mite."
    npcLine: Solo atendemos con turno.
